# ==============================================================================
# Anya Environment Configuration Example
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- Models & Speech ---
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_VISION_MODEL=qwen2.5vl:3b
WHISPER_MODEL=base.en
WAKE_MODEL=tiny.en
WAKE_PHRASES=["hey anya", "anya"]
MODEL_PATH=assets/model
PIPER_VOICE=assets/voices/en_US-lessac-medium.onnx

# --- Audio & Conversation Controls ---
CONVERSATION_WINDOW_S=20
BARGE_IN=false
PUSH_TO_TALK_KEY=space
HISTORY_TURNS=6
NUM_CTX=4096
LLM_IDLE_UNLOAD_S=300

# --- UI & Performance ---
SERVER_PORT=8000
FPS_ACTIVE=30
FPS_IDLE=10

# --- Runtime Flags ---
DRY_RUN=false
DEBUG=false

# --- Proactivity & Focus Policies ---
QUIET_HOURS=23:00-07:00
MAX_PROACTIVE_PER_HOUR=3
BLOCKED_FOCUS_APPS=["Discord"]

# --- Optional Integrations ---
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
